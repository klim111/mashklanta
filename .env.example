# Database
# DATABASE_URL — החיבור השוטף. ב-Neon זהו המארח עם הסיומת -pooler
DATABASE_URL="postgresql://user:password@localhost:5432/nadlanium"
# DIRECT_URL — אותו חיבור בלי ה-pooler. נדרש למיגרציות של Prisma
DIRECT_URL="postgresql://user:password@localhost:5432/nadlanium"

# NextAuth Configuration
# NEXTAUTH_URL — הכתובת שממנה הגולשים טוענים את האתר, בדיוק כפי שהיא בדפדפן:
# אותו פרוטוקול (https בפרודקשן), אותו דומיין (עם www או בלי — לא שניהם), בלי
# סלאש בסוף ובלי מרכאות. ממנה נגזר ה-Redirect URI שנשלח לגוגל, וכל הבדל
# מחזיר "Error 400: redirect_uri_mismatch".
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here-generate-with-openssl

# Google OAuth (הרשמה והתחברות עם חשבון גוגל)
# צרו OAuth Client ב-Google Cloud Console → Credentials, והוסיפו תחת
# "Authorized redirect URIs" את הכתובת הזו בדיוק:
#   {NEXTAUTH_URL}/api/auth/callback/google
# לדוגמה: http://localhost:3000/api/auth/callback/google
# מדריך מלא, כולל הסיבות הנפוצות ל-redirect_uri_mismatch: GOOGLE_OAUTH_SETUP.md
# כדי לראות איזה URI השרת שולח בפועל: GET /api/auth-diagnostics
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Configuration (using Resend)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@nadlanium.com
EMAIL_REPLY_TO=support@nadlanium.com

# SMTP Configuration (alternative to Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Application URLs
APP_URL=http://localhost:3000
PUBLIC_APP_NAME=Nadlanium

# AWS S3 (existing)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=your-aws-region
AWS_S3_BUCKET=your-s3-bucket

# Google Cloud Vision (existing)
GOOGLE_APPLICATION_CREDENTIALS=path-to-your-credentials.json

# Redis (existing)
REDIS_URL=redis://localhost:6379

# Field-level encryption for sensitive client data (income, liabilities, credit score).
# Must decode to exactly 32 bytes. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key means the encrypted columns cannot be read again.
FIELD_ENCRYPTION_KEY=generate-a-32-byte-base64-key