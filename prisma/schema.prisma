// generator and datasource
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // החיבור השוטף עובר דרך ה-pooler של Neon, אבל מיגרציות דורשות חיבור ישיר
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// NextAuth core models
model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  /**
   * שם כניסה ייחודי — אפשר להתחבר איתו במקום המייל
   */
  username       String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  role           UserRole  @default(CLIENT)

  accounts      Account[]
  sessions      Session[]
  documents     Document[]
  calculations  Calculation[]
  /**
   * הלקוחות שהמשתמש מלווה כיועץ
   */
  clients       Client[]          @relation("AdvisorClients")
  /**
   * רשומות הליווי שבהן המשתמש הוא הלקוח
   */
  advisedAs     Client[]          @relation("ClientAccount")
  /**
   * תמהילים שהמשתמש שמר, בין כיועץ ובין כלקוח
   */
  mortgageMixes MortgageMix[]     @relation("MixOwner")
  /**
   * בקשות הריביות שהמשתמש הפיק לתמהילים, לצורך מיקוח מול הבנקים
   */
  rateRequests  BankRateRequest[] @relation("RateRequestOwner")
  /**
   * תהליכי תכנון המשכנתא שהמשתמש פתח באזור האישי
   */
  mortgagePlans MortgagePlan[]    @relation("PlanOwner")
  /**
   * פרופיל פיננסי מההגדרות — פרטי הלווים וההון העצמי בלי פרטי נכס.
   * נטען כברירת מחדל בפתיחת תהליך תכנון חדש.
   */
  profileJson   Json?

  // ───────────────────────── לוח הבקרה של היועץ (CRM) ─────────────────────────
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * /** המשימות שהיועץ פתח לעצמו, לכל לקוח ולכל שלב
   */
  advisorTasks    AdvisorTask[]        @relation("AdvisorTasks")
  /**
   * ההערות שהיועץ כתב בשלבי הלקוח — אישיות או כאלה שנשלחו ללקוח
   */
  advisorNotes    AdvisorNote[]        @relation("AdvisorNotes")
  /**
   * הפגישות שהיועץ הציע ללקוחותיו
   */
  advisorMeetings AdvisorMeeting[]     @relation("AdvisorMeetings")
  /**
   * ריביות ברירת המחדל של היועץ, לכל בנק ולכל לוח סילוקין
   */
  advisorRates    AdvisorRateDefault[] @relation("AdvisorRates")
  /**
   * הקטגוריות שהיועץ הגדיר לתמהילים שאינם משויכים ללקוח
   */
  mixCategories   MixCategory[]        @relation("AdvisorMixCategories")

  // ─────────────────────── האישור העקרוני (איסוף פרטי הבקשה) ───────────────────────
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * תיקי האישור העקרוני שבהם המשתמש הוא הלווה
   */
  approvalCases    MortgageCase[]   @relation("ApprovalCaseClient")
  /**
   * תיקי האישור העקרוני שהמשתמש מטפל בהם כיועץ
   */
  advisedApprovals MortgageCase[]   @relation("ApprovalCaseAdvisor")
  /**
   * הרשאות העריכה שקיבל המשתמש כיועץ על נתונים שהזין הלקוח
   */
  approvalAccess   ApprovalAccess[] @relation("ApprovalAccessAdvisor")

  // ─────────────────────── הזמנת ליווי יועץ לשלבים ───────────────────────
  /**
   * /**
   * /**
   * /**
   * /**
   * /**
   * הזמנות הליווי שהמשתמש ביצע בתהליכי המשכנתא שלו
   */
  advisorOrders       AdvisorServiceOrder[] @relation("AdvisorOrderClient")
  /**
   * הזמנות הליווי שהמשתמש מטפל בהן כיועץ
   */
  advisorOrdersServed AdvisorServiceOrder[] @relation("AdvisorOrderAdvisor")

  // ─────────────────────── פניות ליווי כלליות ───────────────────────
  /**
   * /**
   * /**
   * /** פניות שהמשתמש שלח מהאזור האישי (מצאתי נכס / סירוב / גיוס הון וכו')
   */
  advisorLeads       AdvisorLead[]  @relation("AdvisorLeadClient")
  /**
   * פניות שהופנו למשתמש כיועץ
   */
  advisorLeadsServed AdvisorLead[]  @relation("AdvisorLeadAdvisor")
  /**
   * מסמכים תומכים שהמשתמש העלה לתהליכי המשכנתא שלו
   */
  planDocuments      PlanDocument[] @relation("PlanDocumentOwner")
  /**
   * המועדים והסימונים שהלקוח קבע למשימות ולהמלצות באזור האישי
   */
  taskStates         ClientTaskState[] @relation("ClientTaskStateOwner")

  // ─────────────────────── גישה בתשלום לפלטפורמה ───────────────────────
  /**
   * /**
   * /**
   * מתי הלקוח רכש מנוי חודשי לפלטפורמה — המודל שקדם לתשלום לתהליך. נשמר
   * למנויים הקיימים בלבד: התהליכים שלהם מלפני המעבר נשארים פתוחים. תשלום חדש
   * נרשם ב-PlatformPayment ונקשר לתהליך שהוא פותח.
   */
  platformAccessAt DateTime?
  platformPayments PlatformPayment[] @relation("PlatformPaymentUser")
  /**
   * המשימות המתוכננות שהלקוח הוסיף לעצמו — מתוך השלבים או מלוח השנה
   */
  clientTasks      ClientTask[]      @relation("ClientTaskOwner")
  /**
   * תכנון ההון העצמי וההוצאות הנלוות שהלקוח בנה בכלי תכנון ההוצאות
   */
  equityPlan       EquityPlan?       @relation("EquityPlanOwner")

  // ─────────────────────── התכתבות עם היועץ ───────────────────────
  /**
   * מפתח הכתובת האישית שמקבלת מיילים בשם הלקוח (`c-<key>@<דומיין קבלת המיילים>`).
   * נוצר בפעם הראשונה שנשלח מייל מהפלטפורמה, וכך תשובות הבנקאי חוזרות לשיחה.
   */
  mailboxKey             String?               @unique
  /**
   * ההודעות בשיחה שבה המשתמש הוא הלקוח
   */
  conversationMessages   ConversationMessage[] @relation("ConversationClient")
  /**
   * ההודעות שהמשתמש כתב, בין כלקוח ובין כיועץ
   */
  authoredMessages       ConversationMessage[] @relation("ConversationAuthor")
  /**
   * המיילים של השיחה שבה המשתמש הוא הלקוח — לבנקאי, ליועץ וממנו
   */
  conversationEmails     ConversationEmail[]   @relation("ConversationEmailClient")
  sentConversationEmails ConversationEmail[]   @relation("ConversationEmailSender")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  CLIENT
  ADVISOR
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/**
 * הרשמה שממתינה לאישור הקישור שנשלח במייל.
 *
 * החשבון עצמו (User) נוצר רק כשהקישור מאושר, כך שמייל שאיש לא הוכיח שהוא
 * בבעלותו לעולם אינו הופך למשתמש רשום. לכל מייל יש לכל היותר הרשמה ממתינה
 * אחת; הרשמה חדשה לאותו מייל מחליפה אותה, ורק הקישור האחרון שנשלח תקף.
 * הטוקן עצמו לא נשמר, רק ה-SHA-256 שלו.
 */
model PendingRegistration {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String?
  username          String?
  hashedPassword    String?
  image             String?
  /** "google" להרשמה דרך גוגל; ריק להרשמה עם סיסמה */
  provider          String?
  providerAccountId String?
  tokenHash         String    @unique
  /** hash של עוגיית הדפדפן שממנו נרשמו — אישור מדפדפן אחר דורש את הסיסמה */
  deviceHash        String?
  callbackUrl       String?
  expires           DateTime
  sendCount         Int       @default(1)
  lastSentAt        DateTime  @default(now())
  createdAt         DateTime  @default(now())

  @@index([username])
  @@index([expires])
}

// Domain models
model Document {
  id          String         @id @default(cuid())
  userId      String?
  user        User?          @relation(fields: [userId], references: [id])
  originalUrl String?
  s3Key       String?
  status      DocumentStatus @default(uploaded)
  ocrText     String?
  parsedJson  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DocumentStatus {
  uploaded
  processing
  ready
  failed
}

model Calculation {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  inputsJson  Json
  resultsJson Json
  createdAt   DateTime @default(now())
}

/**
 * ליווי של יועץ ללקוח. הלקוח הוא תמיד משתמש רשום שפתח חשבון בעצמו, ורשומה זו
 * היא הקישור בין היועץ לחשבון הזה — ולכן היועץ רואה רק לקוחות שיש להם חשבון.
 */
model Client {
  id        String @id @default(cuid())
  advisorId String
  advisor   User   @relation("AdvisorClients", fields: [advisorId], references: [id], onDelete: Cascade)
  /**
   * חשבון הלקוח עצמו — דרכו הלקוח רואה את אותם נתונים באזור האישי שלו
   */
  userId    String
  user      User   @relation("ClientAccount", fields: [userId], references: [id], onDelete: Cascade)

  // פרטי לקוח
  name    String
  email   String
  phone   String?
  address String?

  // סטטוס והתקדמות בתהליך
  status   ClientStatus @default(POTENTIAL)
  stage    ClientStage  @default(INTAKE)
  progress Int          @default(0) // 0-100

  // הרכב משק הבית
  household   HouseholdType @default(SINGLE)
  age         Int?
  partnerName String?
  partnerAge  Int?

  // פרטים פיננסיים — מוצפנים ברמת השדה (ראה src/lib/crypto.ts).
  // הערכים המדויקים אינם ניתנים לסינון ב-SQL; incomeBucket הוא העמודה הגלויה היחידה.
  incomeEnc        String?
  partnerIncomeEnc String?
  expensesEnc      String?
  existingLoansEnc String?
  creditScoreEnc   String?
  downPaymentEnc   String?

  /**
   * טווח ההכנסה של משק הבית, גלוי בכוונה. השדות המוצפנים אינם ניתנים לסינון או
   * למיון ב-SQL, ולכן זהו הערך היחיד שרשימת הלקוחות יכולה לסנן לפיו.
   */
  incomeBucket IncomeBucket?

  // העסקה
  propertyValue   Float?
  propertyAddress String?
  mortgageAmount  Float?
  dealType        DealType?

  notes String?

  // ריביות מהבנקים
  bankRates Json?

  mixes         MortgageMix[]
  rateRequests  BankRateRequest[]
  documents     ClientDocument[]
  actions       ClientAction[]
  reminders     Reminder[]
  advisorOrders AdvisorServiceOrder[]
  advisorLeads  AdvisorLead[]
  plans         MortgagePlan[]
  planDocuments PlanDocument[]
  /**
   * משימות היועץ עבור הלקוח, לפי שלבי כלי תכנון המשכנתא
   */
  tasks         AdvisorTask[]
  /**
   * הערות היועץ בשלבי הלקוח
   */
  advisorNotes  AdvisorNote[]
  /**
   * הפגישות שנקבעו בין היועץ ללקוח
   */
  meetings      AdvisorMeeting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * יועץ מלווה לקוח פעם אחת בלבד
   */
  @@unique([advisorId, userId])
  @@index([userId])
  @@index([advisorId, incomeBucket])
}

enum ClientStatus {
  POTENTIAL
  ACTIVE
  IN_PROCESS
}

/**
 * טווחי הכנסה חודשית של משק הבית, בשקלים
 */
enum IncomeBucket {
  UNDER_10K
  FROM_10K_TO_15K
  FROM_15K_TO_25K
  FROM_25K_TO_40K
  ABOVE_40K
}

enum HouseholdType {
  SINGLE
  COUPLE
}

/**
 * סוג העסקה — קובע את תקרת המימון. הערכים זהים לאלה שבקוד הכלי
 */
enum DealType {
  first_home
  replacement_home
  second_home
  any_purpose
}

/**
 * שלבי הליווי. לכל שלב רשימת מסמכים משלו, שנפתחת כשמגיעים אליו
 */
enum ClientStage {
  INTAKE
  DOCUMENTS
  PLANNING
  BANK_SUBMISSION
  APPROVAL
  NEGOTIATION
  SIGNING
  FUNDING
  COMPLETED
}

/**
 * מסמך ברשימת המסמכים של הלקוח. הרשומות נוצרות מקטלוג המסמכים של כל שלב ברגע
 * שהלקוח מגיע לשלב, ומכאן ואילך הן מחזיקות את הסטטוס בפועל.
 */
model ClientDocument {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /**
   * מזהה קבוע מהקטלוג, כדי שלא ייווצרו כפילויות בכל פתיחת שלב
   */
  key         String
  name        String
  stage       ClientStage
  status      ClientDocumentStatus @default(PENDING)
  required    Boolean              @default(true)
  note        String?
  submittedAt DateTime?
  /**
   * קובץ שהועלה למערכת עבור המסמך
   */
  documentId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, key])
  @@index([clientId, stage])
}

enum ClientDocumentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

/**
 * תמהיל שנשמר. זהו מקור האמת היחיד לתמהילים — הן באזור האישי של הלקוח והן
 * בדף הלקוח אצל היועץ. שדות הסיכום משוכפלים לעמודות כדי שרשימות ייטענו בלי
 * לחשב מחדש את כל לוח הסילוקין.
 */
model MortgageMix {
  id         String        @id @default(cuid())
  /**
   * מזהה התמהיל בכלי התכנון, לשמירה חוזרת של אותו תמהיל
   */
  mixKey     String
  ownerId    String
  owner      User          @relation("MixOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /**
   * הלקוח שהתמהיל שייך לו. ריק כשהתמהיל עדיין לא שויך
   */
  clientId   String?
  client     Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /**
   * תהליך המשכנתא שהתמהיל שייך לו. ריק כשהתמהיל נוצר בלי שיוך לנכס
   */
  planId     String?
  plan       MortgagePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  /**
   * קטגוריה שהיועץ הגדיר. משמשת רק לתמהילים שאינם משויכים ללקוח — כך שאזור
   * התמהילים השמורים מסודר לפי הקטגוריות שהיועץ בחר בעת היצירה.
   */
  categoryId String?
  category   MixCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  name            String
  totalAmount     Float
  propertyValue   Float?
  propertyAddress String?
  dealType        DealType?

  // תמונת מצב של הסיכום בזמן השמירה
  monthlyPayment Float
  totalInterest  Float
  totalPaid      Float
  averageRate    Float
  months         Int

  /**
   * התמהיל שנבחר כסופי למכרז מול הבנקים — נעול לעריכה
   */
  isFinal Boolean @default(false)
  locked  Boolean @default(false)

  /**
   * האם התמהיל גלוי ללקוח.
   * תמהיל שיועץ בונה או מתמחר בתוך תיק של לקוח נשמר תחילה אצלו בלבד, כדי
   * שיוכל לעבוד עליו בלי שהלקוח יראה טיוטות. "שדר תמהיל ללקוח" הוא מה שהופך
   * אותו לגלוי. תמהיל שהלקוח שמר בעצמו גלוי לו תמיד.
   */
  sharedWithClient Boolean @default(true)

  /**
   * התמהיל המלא כפי שהכלי מכיר אותו
   */
  mixJson     Json
  summaryJson Json

  savedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, mixKey])
  @@index([clientId])
  @@index([ownerId])
  @@index([planId])
  @@index([categoryId])
}

/**
 * תהליך תכנון משכנתא של הלקוח, מחולק לחמשת השלבים של עמוד "איך זה עובד".
 * זהו מקור האמת להתקדמות הלקוח: הנתונים שהוזנו בכל שלב יושבים ברשומת השלב,
 * ועמודות הסיכום משוכפלות לכאן כדי שרשימת התהליכים תיטען בלי לפרש JSON.
 */
model MortgagePlan {
  id       String  @id @default(cuid())
  ownerId  String
  owner    User    @relation("PlanOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /**
   * רשומת הליווי אצל היועץ, כשקיימת — כדי שהיועץ יראה את אותה התקדמות
   */
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  name         String
  status       PlanStatus @default(IN_PROGRESS)
  currentStage PlanStage  @default(ANALYSIS)
  progress     Int        @default(0) // 0-100

  // תמונת מצב לכרטיס התהליך באזור האישי
  propertyValue   Float?
  propertyAddress String?
  mortgageAmount  Float?
  monthlyPayment  Float?

  completedAt DateTime?

  /**
   * התשלומים שפתחו את התהליך — התשלום הראשון והחידושים אחריו
   */
  platformPayments PlatformPayment[]

  stages        MortgagePlanStage[]
  mixes         MortgageMix[]
  advisorOrders AdvisorServiceOrder[]
  documents     PlanDocument[]
  clientTasks   ClientTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([clientId])
}

/**
 * שלב בודד בתהליך. הנתונים שהלקוח הזין בשלב נשמרים ב-dataJson ונמשכים מכאן
 * לשלבים הבאים, כך שאין צורך להזין את אותו נתון פעמיים.
 */
model MortgagePlanStage {
  id     String       @id @default(cuid())
  planId String
  plan   MortgagePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  stage       PlanStage
  status      PlanStageStatus @default(PENDING)
  dataJson    Json?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([planId, stage])
}

/**
 * מסמך תומך שהלקוח העלה לתהליך.
 * הקובץ עצמו יושב ב-Vercel Blob כאובייקט פרטי, ורק הנתיב אליו נשמר כאן. הנתיב
 * אינו נמסר לדפדפן: הצפייה עוברת דרך מסלול מאומת שבודק שהמבקש הוא בעל התהליך
 * או היועץ שמלווה אותו, ורק אז מזרים את הקובץ. כך אין כתובת שניתן לשתף.
 */
model PlanDocument {
  id       String       @id @default(cuid())
  planId   String
  plan     MortgagePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  ownerId  String
  owner    User         @relation("PlanDocumentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /**
   * כרטיס הלקוח אצל היועץ, כשקיים — כך המסמך מופיע בתיק המסמכים שלו
   */
  clientId String?
  client   Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /**
   * מפתח המסמך מהקטלוג, למשל b1:payslips — מסמך אחד לכל מפתח בתהליך
   */
  key  String
  name String

  fileName    String
  contentType String
  size        Int
  /**
   * הנתיב ב-Vercel Blob. אינו נחשף לדפדפן לעולם
   */
  blobPath    String

  uploadedAt DateTime @default(now())

  @@unique([planId, key])
  @@index([clientId])
  @@index([ownerId])
}

/**
 * מועד וסימון "בוצע" למשימה או להמלצה באזור האישי של הלקוח.
 *
 * המשימות עצמן נגזרות מהנתונים (`buildClientTasks`) ואינן נשמרות; מה שנשמר
 * כאן הוא רק מה שהלקוח קבע בעצמו — מתי לבצע, והאם סימן שביצע. המפתח הוא
 * מזהה המשימה כפי שנגזר, כך שהמועד נשאר צמוד למשימה גם בטעינה הבאה.
 */
model ClientTaskState {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("ClientTaskStateOwner", fields: [userId], references: [id], onDelete: Cascade)

  key   String
  dueAt DateTime?
  /**
   * סומן כבוצע — משמש בעיקר להמלצות שהלקוח מסמן בעצמו
   */
  doneAt DateTime?

  updatedAt DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
}

/**
 * חמשת השלבים כפי שהם מוגדרים בעמוד "איך זה עובד"
 */
enum PlanStage {
  ANALYSIS
  MIX
  APPLICATIONS
  AUCTION
  SIGNING
}

enum PlanStatus {
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum PlanStageStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

/**
 * הזמנת ליווי יועץ לשלבים בתהליך.
 * הלקוח בוחר אילו שלבים יועץ יבצע במקומו — שלב אחד, כמה, או כולם — ומשלם
 * לפי מודל התמחור של הפלטפורמה. עד שההזמנה שולמה השלב נשאר בידי הלקוח;
 * מרגע התשלום הוא מוצג כשלב שהיועץ מבצע, והיועץ מקבל עליו משימה באזור שלו.
 */
model AdvisorServiceOrder {
  id      String       @id @default(cuid())
  planId  String
  plan    MortgagePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  ownerId String
  owner   User         @relation("AdvisorOrderClient", fields: [ownerId], references: [id], onDelete: Cascade)

  /**
   * היועץ שהבקשה נשלחה אליו — זה שיש לו הרשאות על אותו לקוח. ריק כשעדיין לא
   * שויך יועץ ללקוח, ואז הבקשה ממתינה לשיוך
   */
  advisorId String?
  advisor   User?   @relation("AdvisorOrderAdvisor", fields: [advisorId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /**
   * השלבים שהוזמנו, כמערך של PlanStage
   */
  stagesJson Json
  /**
   * הסכום לתשלום בשקלים, אחרי הנחת החבילה המלאה
   */
  amount     Int
  status     AdvisorOrderStatus @default(PENDING_PAYMENT)

  /**
   * אישור התנאים והתשלום. פרטי אמצעי התשלום עצמם אינם נשמרים כאן — רק
   * האסמכתה שמחזיר ספק הסליקה וארבע הספרות האחרונות, לזיהוי החיוב
   */
  termsAcceptedAt DateTime?
  paidAt          DateTime?
  paymentRef      String?
  cardLast4       String?
  payerName       String?

  /**
   * היועץ סימן שהוא כבר עובד על השלב, אחרי שהתשלום עליו סודר מולו. משלב זה
   * הלקוח אינו יכול למחוק את התהליך — העבודה כבר שולמה ומתבצעת
   */
  workStartedAt DateTime?

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([ownerId])
  @@index([advisorId, status])
}

enum AdvisorOrderStatus {
  /**
   * בקשת ליווי חינמית שהלקוח שלח מתוך שלב — היועץ מטפל, התשלום בהמשך
   */
  REQUESTED
  PENDING_PAYMENT
  PAID
  CANCELLED
}

/**
 * פנייה כללית לליווי מיועץ, שנשלחה מהאזור האישי דרך טופס "אל דאגה — יועצי
 * משכלנתא כאן כדי לעזור". להבדיל מהזמנת ליווי לשלב, היא אינה קשורה בהכרח
 * לתהליך פתוח, ומחזיקה את פרטי הקשר ואת נושא הפנייה כדי שהיועץ יחזור ללקוח.
 */
model AdvisorLead {
  id        String  @id @default(cuid())
  /**
   * הלקוח ששלח, כשהוא מחובר. פנייה יכולה להישלח גם בלי חשבון
   */
  ownerId   String?
  owner     User?   @relation("AdvisorLeadClient", fields: [ownerId], references: [id], onDelete: SetNull)
  /**
   * היועץ שהפנייה שויכה אליו, אם ללקוח כבר יש יועץ
   */
  advisorId String?
  advisor   User?   @relation("AdvisorLeadAdvisor", fields: [advisorId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /**
   * נושא הפנייה — הכפתור שממנו נפתחה: REJECTED / DONT_KNOW / EQUITY / FEASIBILITY
   */
  topic String

  name  String
  /**
   * טלפון לחזרה. רשות — לקוח רשום שולח עם פרטי החשבון ויכול להשאיר ריק
   */
  phone String?
  email String
  notes String?

  status AdvisorLeadStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advisorId, status])
  @@index([ownerId])
}

enum AdvisorLeadStatus {
  OPEN
  HANDLED
  CLOSED
}

model ClientAction {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  type        ActionType
  description String
  status      ActionStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ActionType {
  CALL
  EMAIL
  MEETING
  DOCUMENT_REVIEW
  RATE_NEGOTIATION
  APPLICATION_SUBMISSION
  FOLLOW_UP
}

enum ActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Reminder {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  title       String
  description String?
  dueDate     DateTime
  isCompleted Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RatesCache {
  key       String   @id
  payload   Json
  expiresAt DateTime
}

// ────────────────────────── לוח הבקרה של היועץ (CRM) ──────────────────────────

/**
 * משימה של היועץ עבור לקוח מסוים, בשלב מסוים.
 * השלבים כאן הם בדיוק חמשת השלבים של כלי תכנון המשכנתא (PlanStage), כדי
 * שהמשימות של היועץ ייגזרו מאותו תהליך שהלקוח רואה אצלו — ולא מרצף נפרד.
 */
model AdvisorTask {
  id        String  @id @default(cuid())
  advisorId String
  advisor   User    @relation("AdvisorTasks", fields: [advisorId], references: [id], onDelete: Cascade)
  /**
   * הלקוח שהמשימה שייכת לו. ריק — משימה של היועץ עצמו, בלי שיוך ללקוח
   */
  clientId  String?
  client    Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  stage       PlanStage
  title       String
  details     String?
  /**
   * התאריך והשעה שהיועץ קבע למשימה. זה מה שמרכז אותה בלוח השנה
   */
  dueDate     DateTime?
  status      AdvisorTaskStatus @default(OPEN)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advisorId, dueDate])
  @@index([clientId, stage])
}

enum AdvisorTaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

/**
 * הערה של היועץ בשלב מסוים אצל לקוח.
 * הערה אישית נשארת אצל היועץ בלבד; הערה משותפת מוצגת ללקוח באותו שלב בכלי
 * התכנון שלו, לצד שם היועץ.
 */
model AdvisorNote {
  id        String @id @default(cuid())
  advisorId String
  advisor   User   @relation("AdvisorNotes", fields: [advisorId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  stage      PlanStage
  body       String
  visibility NoteVisibility @default(PRIVATE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId, stage])
  @@index([advisorId, createdAt])
}

enum NoteVisibility {
  /**
   * אישית — רק היועץ רואה
   */
  PRIVATE
  /**
   * נשלחה ללקוח — מוצגת גם אצלו באותו שלב
   */
  SHARED
}

/**
 * פגישה בין היועץ ללקוח. היועץ מציע מועד, והפגישה מופיעה מיד בלוח השנה שלו
 * כפגישה מתוכננת. אישור הלקוח הוא שהופך אותה למאושרת.
 */
model AdvisorMeeting {
  id        String @id @default(cuid())
  advisorId String
  advisor   User   @relation("AdvisorMeetings", fields: [advisorId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /**
   * השלב שממנו נקבעה הפגישה, כשנקבעה מתוך שלב ולא משורת הלקוח
   */
  stage           PlanStage?
  title           String
  startsAt        DateTime
  durationMinutes Int           @default(45)
  /**
   * מיקום פיזי או קישור לשיחת וידאו
   */
  location        String?
  note            String?
  status          MeetingStatus @default(PROPOSED)
  respondedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advisorId, startsAt])
  @@index([clientId, startsAt])
}

enum MeetingStatus {
  /**
   * הוצעה ללקוח וממתינה לאישורו
   */
  PROPOSED
  /**
   * הלקוח אישר את המועד
   */
  CONFIRMED
  DECLINED
  CANCELLED
}

/**
 * ריבית ברירת מחדל של היועץ לצירוף בנק + לוח סילוקין + סוג מסלול.
 * היועץ מזין אותן פעם אחת בהגדרות, ומכאן והלאה כל מסלול חדש בכלי בניית
 * התמהיל נפתח עם הערך הזה — וניתן לשנות אותו בעת היצירה בלי לגעת בהגדרות.
 */
model AdvisorRateDefault {
  id        String @id @default(cuid())
  advisorId String
  advisor   User   @relation("AdvisorRates", fields: [advisorId], references: [id], onDelete: Cascade)

  /**
   * שם הבנק כפי שהוא מופיע ב-MORTGAGE_BANKS
   */
  bank             String
  /**
   * לוח הסילוקין כפי שהוא מופיע ב-AMORTIZATION_TYPES
   */
  amortizationType String
  /**
   * סוג המסלול כפי שהוא מופיע ב-TRACK_TYPES
   */
  trackType        String
  /**
   * ריבית שנתית באחוזים — הריבית הסופית (עוגן + מרווח)
   */
  rate             Float
  /**
   * המרווח שהבנק גובה מעל העוגן, בנקודות אחוז.
   * כשהוא קיים, הריבית הסופית של מסלול חדש נגזרת מהעוגן העדכני של בנק ישראל
   * ועוד המרווח הזה, ולכן היא מתעדכנת עם השוק. כשהוא ריק נעשה שימוש ב-`rate`
   * כפי שהוא, לתאימות עם ריביות שנשמרו לפני הפירוק לעוגן ומרווח.
   */
  spread           Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([advisorId, bank, amortizationType, trackType])
  @@index([advisorId])
}

/**
 * קטגוריה שהיועץ הגדיר לסידור התמהילים שאינם משויכים ללקוח
 */
model MixCategory {
  id        String @id @default(cuid())
  advisorId String
  advisor   User   @relation("AdvisorMixCategories", fields: [advisorId], references: [id], onDelete: Cascade)

  name      String
  /**
   * צבע לתצוגה בלוח התמהילים
   */
  color     String?
  sortOrder Int     @default(0)

  mixes MortgageMix[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([advisorId, name])
  @@index([advisorId, sortOrder])
}

/**
 * בקשה להצעת ריביות — תמהיל שהוגש לבנקים למיקוח, בלי הריביות.
 * נשמרים התמהיל כפי שהוגש והפרטים שמולאו במכתב; המכתב עצמו נבנה מחדש בכל
 * טעינה מהתמהיל, כך שיש מקור אמת אחד ולא עותק קפוא של המסמך.
 */
model BankRateRequest {
  id       String  @id @default(cuid())
  ownerId  String
  owner    User    @relation("RateRequestOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /**
   * הלקוח שהבקשה שייכת לו, כדי שהיועץ והלקוח יראו את אותה רשימה
   */
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /**
   * מזהה הבקשה בכלי, לשמירה חוזרת של אותה בקשה
   */
  requestKey String
  /**
   * מספר האסמכתה שמופיע במכתב
   */
  reference  String
  /**
   * מזהה התמהיל שממנו הופקה הבקשה
   */
  mixKey     String

  name            String
  bankName        String?
  propertyAddress String?
  totalAmount     Float
  trackCount      Int
  months          Int

  /**
   * התמהיל כפי שהוגש, והפרטים שמולאו במכתב
   */
  mixJson     Json
  detailsJson Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, requestKey])
  @@index([ownerId, createdAt])
  @@index([clientId])
}

// ─────────────────────── האישור העקרוני — איסוף פרטי הבקשה ───────────────────────
//
// שלב איסוף הפרטים לקראת אישור עקרוני: פרטי הלווים והערבים, ההכנסות, חשבונות
// הבנק ומקורות המימון. הנתונים נשמרים ברמת השדה הבודד כדי ששמירה אוטומטית תוכל
// לרוץ על כל הקלדה בנפרד, וכדי לזכור מי הזין כל שדה — הלקוח או היועץ.
//
// פרופיל הלקוח עצמו אינו נשמר כאן: הוא נשאר ב-User.profileJson ונקרא דרך
// src/lib/client-profile.ts, וכך יש מקור אמת אחד לפרופיל בכל המערכת.
// הקישור יועץ↔לקוח נשען על מודל Client הקיים ולא על טבלה נוספת.

/**
 * תיק אישור עקרוני אחד של לקוח.
 */
model MortgageCase {
  id        String   @id @default(cuid())
  clientId  String
  client    User     @relation("ApprovalCaseClient", fields: [clientId], references: [id], onDelete: Cascade)
  /**
   * היועץ המטפל, אם התיק נפתח מתוך לוח הבקרה של היועץ
   */
  advisorId String?
  advisor   User?    @relation("ApprovalCaseAdvisor", fields: [advisorId], references: [id])
  title     String   @default("אישור עקרוני")
  status    String   @default("draft") // draft | submitted | approved | archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entities  CaseEntity[]
  fields    CaseField[]
  conflicts FieldConflict[]
  accesses  ApprovalAccess[]

  @@index([clientId])
  @@index([advisorId])
}

/**
 * רשומה חוזרת בתוך התיק: לווה, ערב, הכנסה, מקום עבודה קודם, חשבון בנק או מקור
 * מימון. שדות ברמת התיק עצמו משתמשים במזהה הקבוע "case".
 */
model CaseEntity {
  id        String       @id @default(cuid())
  caseId    String
  case      MortgageCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// borrower | guarantor | income | prevEmployment | bankAccount | fundingSource
  type      String
  /// הלווה/הערב שאליו שייכת ההכנסה או מקום העבודה הקודם
  parentId  String?
  position  Int          @default(0)
  createdAt DateTime     @default(now())

  @@index([caseId, type])
  @@index([parentId])
}

/**
 * תשובה בודדת.
 * ערכים רגישים (הכנסות, הון עצמי, מקורות מימון, מספרי חשבון ותעודות זהות)
 * נשמרים מוצפנים ב-valueEnc דרך src/lib/crypto.ts, באותה מדיניות שנוהגת
 * בשדות הכספיים של מודל Client. שאר הערכים נשמרים כטקסט ב-value.
 */
model CaseField {
  id          String       @id @default(cuid())
  caseId      String
  case        MortgageCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  /// case | borrower | guarantor | income | prevEmployment | bankAccount | fundingSource
  entityType  String
  /// CaseEntity.id, או "case" לשדות ברמת התיק
  entityId    String
  fieldKey    String
  /// ערך גלוי, מקודד JSON
  value       String?
  /// ערך רגיש ומוצפן, מקודד JSON לפני ההצפנה
  valueEnc    String?
  /// client | advisor | profile
  source      String       @default("client")
  updatedById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([caseId, entityType, entityId, fieldKey])
  @@index([caseId])
}

/**
 * סתירה בין ערך שמולא מפרופיל הלקוח לבין הערך שהוזן באישור העקרוני.
 * נשארת פתוחה עד שהמשתמש בוחר איזה ערך נכון.
 */
model FieldConflict {
  id            String       @id @default(cuid())
  caseId        String
  case          MortgageCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  entityType    String
  entityId      String
  fieldKey      String
  /// שני הצדדים, מקודדים JSON ומוצפנים כשהשדה רגיש
  profileValue  String?
  caseValue     String?
  encrypted     Boolean      @default(false)
  status        String       @default("open") // open | resolved
  resolvedValue String?
  resolvedWith  String? // profile | case
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([caseId, entityType, entityId, fieldKey])
  @@index([caseId, status])
}

/**
 * הרשאה מפורשת שהלקוח נותן ליועץ מסוים לערוך נתונים שהלקוח עצמו הזין.
 * בלעדיה היועץ רואה את אותם שדות לקריאה בלבד.
 */
model ApprovalAccess {
  id        String       @id @default(cuid())
  caseId    String
  case      MortgageCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  advisorId String
  advisor   User         @relation("ApprovalAccessAdvisor", fields: [advisorId], references: [id], onDelete: Cascade)
  canEdit   Boolean      @default(false)
  grantedAt DateTime     @default(now())
  revokedAt DateTime?

  @@unique([caseId, advisorId])
  @@index([advisorId])
}

/**
 * קטלוג סניפי הבנקים (קוד ושם) עבור רשימות הבחירה.
 * מיובא מהמאגר הציבורי הרשמי דרך `npm run sync:bank-branches`.
 */
model BankBranch {
  id         String   @id @default(cuid())
  bankCode   String
  bankName   String
  branchCode String
  branchName String
  address    String?
  city       String?
  zipCode    String?
  updatedAt  DateTime @updatedAt

  @@unique([bankCode, branchCode])
  @@index([bankCode])
}

/**
 * תשלום על גישה לפלטפורמה. מספר הכרטיס המלא לעולם אינו נשמר — רק המותג
 * וארבע הספרות האחרונות, לקבלה.
 */
model PlatformPayment {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("PlatformPaymentUser", fields: [userId], references: [id], onDelete: Cascade)

  /**
   * הסכום באגורות, כדי שלא יהיו שברי שקל
   */
  amountAgorot Int
  currency     String @default("ILS")
  holderName   String
  cardBrand    String
  cardLast4    String
  status       String @default("PAID")

  /**
   * התהליך שהתשלום פותח. ריק — תשלום שעוד לא נקשר לתהליך, והוא נקשר לתהליך
   * הבא שנפתח. כל תשלום הוא חבילת גישה ל-30 יום (src/lib/process-access.ts).
   */
  planId String?
  plan   MortgagePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([planId])
}

// ─────────────────────── המשימות המתוכננות של הלקוח ───────────────────────

enum ClientTaskKind {
  TASK
  MEETING
  DOCUMENT
}

enum ClientTaskStatus {
  OPEN
  DONE
}

/**
 * משימה שהלקוח הוסיף לעצמו: מתבנית של השלב (תדפיסי עו״ש, פגישה עם יועץ בבנק,
 * פגישה עם עורך דין) או בניסוח חופשי. פגישה ומשימה עם מועד מופיעות בלוח השנה;
 * משימת מסמך נסגרת כשהמסמך הועלה לתיק.
 */
model ClientTask {
  id      String        @id @default(cuid())
  ownerId String
  owner   User          @relation("ClientTaskOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  /**
   * התהליך והשלב שמהם נוספה, כשנוספה מתוך שלב. ריקים — משימה כללית מלוח השנה
   */
  planId  String?
  plan    MortgagePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  stage   PlanStage?

  kind        ClientTaskKind
  templateKey String?
  title       String
  details     String?
  /**
   * הבנק, כשהמשימה היא פגישה עם יועץ בבנק
   */
  bank        String?
  dueAt       DateTime?
  status      ClientTaskStatus @default(OPEN)
  /**
   * המסמך שהועלה לתיק, כשמשימת המסמך בוצעה
   */
  documentId  String?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
  @@index([planId, stage])
  @@index([ownerId, dueAt])
}

/**
 * תכנון ההון העצמי וההוצאות הנלוות לרכישת דירה — הפלט של כלי תכנון ההוצאות.
 *
 * ללקוח יש תכנון אחד, שנשמר ברגע שהוא נרשם ומתעדכן בכל שינוי בכלי. עמודות
 * הסיכום משוכפלות מתוך הטבלה כדי שהדאשבורד יציג את תמונת המצב בלי לפרש JSON,
 * והשורות המלאות — כולל מועד התשלום של כל הוצאה — יושבות ב-expensesJson וזורמות
 * ללוח השנה הראשי של האזור האישי.
 */
model EquityPlan {
  id      String @id @default(cuid())
  ownerId String @unique
  owner   User   @relation("EquityPlanOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  propertyPrice Float     @default(0)
  /**
   * תאריך היעד לרכישה, שממנו נגזרים מועדי התשלום המוצעים
   */
  targetDate    DateTime?
  /**
   * פרופיל המימון: first-home / replacement / investment / any-purpose
   */
  financingProfile String @default("first-home")
  /**
   * העסקה מבוצעת בעזרת מתווך — מפעיל את ברירת המחדל בשורת התיווך
   */
  usesBroker       Boolean @default(false)

  // תמונת מצב של הסיכום בזמן השמירה
  minEquityRequired Float @default(0)
  totalExpenses     Float @default(0)
  totalRequired     Float @default(0)

  /**
   * שורות ההוצאות המלאות, כפי שהכלי מכיר אותן
   */
  expensesJson Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ───────────────────────── התכתבות לקוח–יועץ ─────────────────────────

/**
 * הודעה בצ'אט בין הלקוח ליועץ. לכל לקוח שיחה אחת, והיא מזוהה בחשבון הלקוח —
 * כך השיחה נשמרת גם לפני שיועץ שויך אליו, וגם אם היועץ מתחלף.
 */
model ConversationMessage {
  id           String           @id @default(cuid())
  clientUserId String
  clientUser   User             @relation("ConversationClient", fields: [clientUserId], references: [id], onDelete: Cascade)
  authorId     String?
  author       User?            @relation("ConversationAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorRole   ConversationRole
  body         String
  /**
   * מתי הצד השני קרא את ההודעה
   */
  readAt       DateTime?
  createdAt    DateTime         @default(now())

  @@index([clientUserId, createdAt])
}

enum ConversationRole {
  CLIENT
  ADVISOR
}

enum EmailDirection {
  /**
   * נשלח מהפלטפורמה — מהלקוח או מהיועץ
   */
  OUTBOUND
  /**
   * התקבל בכתובת האישית של הלקוח — תשובת בנקאי, או מייל שהלקוח העביר
   */
  INBOUND
}

/**
 * מייל בשיחה של הלקוח: מה שנשלח מהפלטפורמה לבנקאי או ליועץ, ומה שחזר לכתובת
 * האישית של הלקוח. הטקסט נשמר כטקסט בלבד — HTML מבחוץ אינו מוצג כמו שהוא.
 */
model ConversationEmail {
  id              String            @id @default(cuid())
  clientUserId    String
  clientUser      User              @relation("ConversationEmailClient", fields: [clientUserId], references: [id], onDelete: Cascade)
  direction       EmailDirection
  senderId        String?
  sender          User?             @relation("ConversationEmailSender", fields: [senderId], references: [id], onDelete: SetNull)
  senderRole      ConversationRole?
  fromAddress     String
  fromName        String?
  toAddresses     String[]
  ccAddresses     String[]
  subject         String
  text            String
  /**
   * הבנק שהמייל שייך אליו, כשהנמען או השולח הוא בנקאי שהלקוח הזין
   */
  bank            String?
  /**
   * המזהה אצל ספק המיילים — מונע שמירה כפולה של אותו מייל נכנס
   */
  providerId      String?           @unique
  messageId       String?
  /**
   * הקבצים שצורפו למייל נכנס: [{ id, fileName, contentType, size }]. הקבצים
   * עצמם נשארים אצל ספק המיילים ונמשכים בכל צפייה
   */
  attachments     Json?
  readByClientAt  DateTime?
  readByAdvisorAt DateTime?
  createdAt       DateTime          @default(now())

  @@index([clientUserId, createdAt])
}
